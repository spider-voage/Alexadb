NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
DB_PATH=./alexadb.sqlite
JWT_SECRET=your-super-secret-jwt-access-token-key-min-64-chars-long
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-min-64-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=AlexaDB
SMTP_FROM_EMAIL=noreply@alexadb.com
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-min-32-chars
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads
